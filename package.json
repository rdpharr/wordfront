{
  "name": "wordfront",
  "private": true,
  "version": "1.0.0",
  "description": "Wordfront: an arcade typing shooter",
  "license": "MIT",
  "author": "rdpharr",
  "homepage": "https://rdpharr.github.io/wordfront/",
  "repository": {
    "type": "git",
    "url": "https://github.com/rdpharr/wordfront.git"
  },
  "bugs": "https://github.com/rdpharr/wordfront/issues",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "replay": "tsx tools/replay.ts",
    "simulate": "tsx tools/simulate.ts",
    "analyze": "uv run -q --no-project --with duckdb==2.0.1 python -I tools/analyze.py",
    "assets": "python tools/process_assets.py",
    "version": "node tools/sync_version.mjs && git add src-tauri/Cargo.toml src-tauri/Cargo.lock",
    "version:check": "node tools/sync_version.mjs --check"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^22.20.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
