{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wordfront",
  "version": "../package.json",
  "identifier": "io.github.rdpharr.wordfront",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5199",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Wordfront",
        "width": 540,
        "height": 940,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "backgroundColor": "#10202a"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; media-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "rdpharr",
    "category": "Game",
    "copyright": "Copyright © 2026 rdpharr. MIT License.",
    "shortDescription": "An arcade typing shooter",
    "longDescription": "Enemies march down the road toward your squad. Type the words on them to shoot them before they reach the barricade. Free and open source.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "section": "games"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2QjVDRTc3RTE4M0QxOTIKUldTUzBZUGhkODYxZGtDMlo4Ykw2T3hGN1BjUFJMS3BKUkRDcTBCc0RvbnN4Ynl6YlREak1JcW8K",
      "endpoints": ["https://github.com/rdpharr/wordfront/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
