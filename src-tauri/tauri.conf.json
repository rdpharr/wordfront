{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wordfront",
  "version": "0.1.0",
  "identifier": "com.wordfront.game",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5199",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Wordfront",
        "width": 540,
        "height": 940,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "backgroundColor": "#10202a"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; media-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
