{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/review-gate.mjs\"",
            "shell": "bash",
            "timeout": 30,
            "onFailure": "block",
            "statusMessage": "Checking code review before commit"
          }
        ]
      }
    ]
  }
}
